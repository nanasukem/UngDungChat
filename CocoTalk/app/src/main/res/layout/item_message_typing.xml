<?xml version="1.0" encoding="utf-8"?>
<!-- Bong bóng "đang nhập": avatar nhỏ + 3 chấm nhảy (giống Messenger) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/typing_indicator"
    android:gravity="bottom"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="64dp"
    android:paddingBottom="1dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="A" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/typingBubble"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_bubble_received"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_typing_dot" />

        <View
            android:id="@+id/dot2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_typing_dot" />

        <View
            android:id="@+id/dot3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_typing_dot" />
    </LinearLayout>
</LinearLayout>
